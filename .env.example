# Motor de extracción de Booking: "graphql" (por defecto, API interna de
# Booking vía Playwright, ver backend/app/booking_graphql/) o "decodo"
# (proxy de pago + HTML, ver backend/app/decodo.py). Requiere
# `playwright install chromium` en el servidor cuando es "graphql".
SCRAPER_BACKEND=graphql

# Entorno y acceso. En producción ambos son obligatorios: la interfaz muestra
# un acceso de sesión antes de permitir llamadas operativas a la API.
APP_ENV=development
# APP_AUTH_PASSWORD=usa_un_secreto_largo_y_unico
# FLASK_SECRET_KEY=usa_otro_secreto_largo_y_unico

# Decodo (solo si SCRAPER_BACKEND=decodo)
DECODO_USERNAME=tu_usuario_decodo
DECODO_PASSWORD=tu_password_decodo
# Alternativa: token Basic Auth en Base64 de "usuario:password"
# DECODO_TOKEN=VTAwMDA...
DECODO_API_URL=https://scraper-api.decodo.com/v2/scrape
DECODO_LOCALE=es-es
DECODO_GEO=Spain
DECODO_PROXY_POOL=premium

# SerpApi
# Si no se configura, Air_Data usa datos mock/demostrativos.
SERPAPI_API_KEY=tu_api_key_serpapi
AIR_DATA_SOURCE=serpapi
AIR_DATA_CURRENCY=EUR
AIR_DATA_HL=es
AIR_DATA_GL=es
# Formato: ORIGEN,DESTINO,IDA,VUELTA,MERCADO;...
AIR_DATA_ROUTES=MAD,LPA,2026-08-24,2026-08-30,Madrid;BCN,LPA,2026-08-24,2026-08-30,Barcelona;DUS,LPA,2026-08-24,2026-08-31,Düsseldorf;FRA,LPA,2026-08-24,2026-08-31,Frankfurt;LHR,LPA,2026-08-24,2026-08-31,Londres Heathrow

# OpenRouter (Revenue Copilot del chat /ask)
# Si no se configura, el comando /ask responde con un aviso de configuracion.
OPENROUTER_API_KEY=tu_api_key_openrouter
# Modelo OpenRouter (formato proveedor/modelo). Ejemplos:
#   openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Política de retención exigida al proveedor. ``deny`` requiere un endpoint
# compatible con zero-data-retention; usa ``allow`` solo tras revisar la
# configuración de privacidad de OpenRouter.
OPENROUTER_DATA_COLLECTION=deny
# Routing por tipo de consulta. Si no se indican, se usan estos valores seguros.
OPENROUTER_FAST_MODEL=openai/gpt-5.6-luna
OPENROUTER_HOTEL_MODEL=openai/gpt-5.6-terra
OPENROUTER_AIR_MODEL=z-ai/glm-5.3-flash
# Si GLM no responde dentro de su presupuesto, el análisis aéreo continúa con Luna.
OPENROUTER_AIR_FALLBACK_MODEL=openai/gpt-5.6-luna
OPENROUTER_CRITIC_MODEL=openai/gpt-5.6-luna
OPENROUTER_SYNTHESIS_MODEL=openai/gpt-5.6-sol
# MoA solo se aplica a decisiones complejas; permite desactivarlo temporalmente sin cambiar el routing.
COPILOT_MOA_ENABLED=true
# Límite por cliente para llamadas costosas y retención de telemetría (sin
# contenido de conversaciones). La purga se ejecuta explícitamente mediante
# el comando de mantenimiento documentado.
COPILOT_REQUESTS_PER_MINUTE=20
COPILOT_AUDIT_RETENTION_DAYS=90

SQLITE_PATH=./data/booking-prices.sqlite
DATABASE_PROVIDER=sqlite
# Para Supabase/PostgreSQL:
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://postgres.zsyuofgspuxtuafijgxa:TU_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
