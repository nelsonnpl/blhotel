# Decodo
DECODO_USERNAME=tu_usuario_decodo
DECODO_PASSWORD=tu_password_decodo
# Alternativa: token Basic Auth en Base64 de "usuario:password"
# DECODO_TOKEN=VTAwMDA...
DECODO_API_URL=https://scraper-api.decodo.com/v2/scrape
DECODO_LOCALE=es-es
DECODO_GEO=Spain
DECODO_PROXY_POOL=premium

# SerpApi
# Si no se configura, Air_Data usa datos mock/demostrativos.
SERPAPI_API_KEY=tu_api_key_serpapi
AIR_DATA_SOURCE=serpapi
AIR_DATA_CURRENCY=EUR
AIR_DATA_HL=es
AIR_DATA_GL=es
# Formato: ORIGEN,DESTINO,IDA,VUELTA,MERCADO;...
AIR_DATA_ROUTES=MAD,LPA,2026-08-24,2026-08-30,Madrid;BCN,LPA,2026-08-24,2026-08-30,Barcelona;DUS,LPA,2026-08-24,2026-08-31,Düsseldorf;FRA,LPA,2026-08-24,2026-08-31,Frankfurt;LHR,LPA,2026-08-24,2026-08-31,Londres Heathrow

# Copiloto IA (/ask en la barra de comandos) via OpenRouter (API compatible con OpenAI).
# Sin OPENROUTER_API_KEY, la IA muestra un aviso de configuración. Key gratis: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-tu_api_key_openrouter
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/owl-alpha
# owl-alpha tiene ventana de contexto pequena (~4k tokens). Estos limites
# recortan snapshot/historial para no superarla. Sube los valores si cambias
# a un modelo con mas contexto (p.ej. AI_SNAPSHOT_CHARS=12000, AI_MAX_TOKENS=800).
# AI_SNAPSHOT_CHARS=6000
# AI_HISTORY_TURNS=8
# AI_HISTORY_CHARS=1500
# AI_MAX_TOKENS=600

SQLITE_PATH=./data/booking-prices.sqlite
DATABASE_PROVIDER=sqlite
# Para Supabase/PostgreSQL:
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database
